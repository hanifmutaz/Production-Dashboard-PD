{
  "name": "dashboard-production-v3",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "apps/api"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @v3/api",
    "build": "npm run build -w @v3/shared && npm run build -w @v3/api",
    "typecheck": "tsc -p packages/shared --noEmit && tsc -p apps/api --noEmit && tsc -p scripts",
    "lint": "eslint packages/shared/src apps/api/src scripts",
    "format:check": "prettier --check \"packages/shared/src/**/*.ts\" \"apps/api/src/**/*.ts\" \"scripts/**/*.ts\"",
    "format": "prettier --write \"packages/shared/src/**/*.ts\" \"apps/api/src/**/*.ts\" \"scripts/**/*.ts\"",
    "test": "vitest run",
    "test:unit": "vitest run packages/shared",
    "test:integration": "vitest run apps/api",
    "test:e2e": "echo \"BELUM ADA: Playwright menunggu Tahap E (frontend)\" && exit 1",
    "db:migrate": "node-pg-migrate up -m apps/api/migrations -d DASHBOARD_DATABASE_URL",
    "db:migrate:down": "node-pg-migrate down -m apps/api/migrations -d DASHBOARD_DATABASE_URL",
    "db:seed:dev": "tsx scripts/seedDevFixture.ts",
    "db:seed:admin": "tsx scripts/createAdmin.ts",
    "validate:columns": "tsx scripts/validateColumns.ts",
    "verify": "npm run validate:columns && npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "pg-mem": "^3.0.14",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.1-alpha.0",
    "vitest": "^5.1.0"
  }
}
