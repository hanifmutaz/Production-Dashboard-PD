# Salin ke .env lalu isi. Jangan commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=1
CORS_ORIGIN=

# DB ConMas — WAJIB akun read-only (INV-001). Pool juga memaksa default_transaction_read_only=on.
CONMAS_DATABASE_URL=postgres://readonly_user:CHANGE_ME@localhost:5432/irepodb
DB_VIEW_NAME=view_report_25415
REPORT_COLUMNS_PATH=config/reportColumns.js

# DB dashboard (user, role, target, kalender, settings, audit, dst). Terpisah dari ConMas.
DASHBOARD_DATABASE_URL=postgres://dashboard_app:CHANGE_ME@localhost:5432/dashboard_v3

SOURCE_NAME=internal
SUBCONT_ENABLED=false
SYNC_KEY_SGP=
SYNC_KEY_SYSTECH=
SYNC_STALE_AFTER_SEC=300

SESSION_TTL_HOURS=12
COOKIE_SECURE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PAIRING_CODE_TTL_MIN=10

SHIFT2_START_HOUR=7
SHIFT2_END_HOUR_WEEKDAY=16
SHIFT2_END_HOUR_FRIDAY=17
SHIFT2_NIGHT_START_HOUR=22
SHIFT3_START_HOUR=6
SHIFT3_SECOND_START_HOUR=14
SHIFT3_THIRD_START_HOUR=22
LINE_NOT_RUNNING_THRESHOLD_MIN=120
# LINE_START_GRACE_MIN=120   (default = threshold)
HOURLY_SLOT_OFFSET=0
EXECUTIVE_CACHE_SEC=30
